# Copy into apps/store-hub/.env only on an isolated local QA workstation.
NODE_ENV=development
STORE_DB_PATH=./store-data/e2e-disposable/bmc-e2e.sqlite
BOOTSTRAP_OWNER_PIN=<GENERATE_UNIQUE_QA_PIN_12_PLUS>
BOOTSTRAP_CASHIER_PIN=<GENERATE_DIFFERENT_QA_PIN_12_PLUS>
BOOTSTRAP_STAFF_PIN=<GENERATE_DIFFERENT_QA_PIN_12_PLUS>
SEED_DEMO_CATALOG=1
HUB_BIND_HOST=127.0.0.1
HUB_PORT=4400
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
# Do not configure real bank, printer, production Cloud or customer data.
# Leave BANK_BRIDGE_SECRET, ENABLE_VERIFIED_BANK_INBOX, CLOUD_SYNC_URL and printer credentials unset.
