# Seed command only; do not use as production runtime config.
E2E_ALLOW_SEED=YES
E2E_ISOLATED_DB_MARKER=BMC_E2E_DISPOSABLE
E2E_HUB_URL=http://127.0.0.1:4400
E2E_SEED_ORDERS=340
E2E_SEED_REPORT=./e2e-seed-report.json
# Must match local Hub process; all four PINs must be distinct and >=12 characters.
BOOTSTRAP_OWNER_PIN=<QA_OWNER_PIN>
BOOTSTRAP_CASHIER_PIN=<QA_CASHIER_PIN>
BOOTSTRAP_STAFF_PIN=<QA_STAFF_PIN>
E2E_EXTRA_STAFF_PIN=<DISTINCT_QA_EXTRA_STAFF_PIN>
