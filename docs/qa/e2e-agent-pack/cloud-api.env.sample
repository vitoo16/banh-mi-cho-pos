# Optional isolated Cloud tests only. Never use production database or credentials.
DATABASE_URL=postgresql://bmc_qa:REPLACE_LOCAL_QA_PASSWORD@127.0.0.1:5432/bmc_qa
CLOUD_STORE_ID=bmc-qa-isolated
CLOUD_SYNC_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
CLOUD_OWNER_LOGIN_SECRET=<DIFFERENT_SECRET_AT_LEAST_16_CHARACTERS>
CLOUD_PORT=4500
CLOUD_BIND_HOST=127.0.0.1
CLOUD_ALLOWED_ORIGIN=http://127.0.0.1:5174
# Leave SePay webhook and merchant information unset in default run.
