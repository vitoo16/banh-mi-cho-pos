DATABASE_URL=postgresql://bmc_cloud:replace_password@localhost:5432/bmc_cloud
CLOUD_STORE_ID=banh-mi-cho-main
CLOUD_SYNC_SECRET=at-least-32-random-characters
CLOUD_OWNER_LOGIN_SECRET=another-unique-secret-16-or-more-characters
CLOUD_PORT=4500
CLOUD_BIND_HOST=127.0.0.1
# Use reverse proxy/managed TLS for production. No plain public HTTP.
CLOUD_ALLOWED_ORIGIN=http://localhost:5174

