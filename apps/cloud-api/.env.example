# All values are examples. Configure in a proper secret manager; no live secrets in Git.
DATABASE_URL=postgresql://bmc:replace-me@127.0.0.1:5432/bmc
# Shared TLS-only server-to-server credential, at least 32 random chars.
CLOUD_SYNC_TOKEN=replace-with-cryptographically-random-long-token
# SePay webhook HMAC-SHA256 configuration (signed over timestamp.raw-body)
SEPAY_WEBHOOK_SECRET=replace-with-an-independent-long-secret
BANK_ACCOUNT_NUMBER=your-real-business-bank-account
BANK_BIN=your-real-bank-bin
CLOUD_BIND_HOST=127.0.0.1
CLOUD_PORT=4500
# Set CLOUD_ALLOW_INSECURE_DEV=1 ONLY on disposable isolated test LAN
