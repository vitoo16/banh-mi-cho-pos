# Development only. Choose unique strong PINs; NEVER commit actual values.
BOOTSTRAP_OWNER_PIN=replace-with-unique-long-owner-pin
BOOTSTRAP_CASHIER_PIN=replace-with-unique-long-cashier-pin
BOOTSTRAP_STAFF_PIN=replace-with-unique-long-staff-pin
STORE_DB_PATH=./store-data/bmc.sqlite
SEED_DEMO_CATALOG=1
HUB_BIND_HOST=127.0.0.1
HUB_PORT=4400
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# LAN access must use trusted TLS + device pairing prior to production.

# Bank bridge HMAC event delivery, NOT direct bank webhook. Keep disabled without verified adapter.
# BANK_CODE=...
# BANK_ACCOUNT_NUMBER=...
# BANK_BRIDGE_SECRET=use-strong-random-32-plus-characters

# Optional outbound-only HTTPS cloud replication
# CLOUD_SYNC_URL=https://your-cloud.example
# CLOUD_STORE_ID=banh-mi-cho-main
# CLOUD_SYNC_SECRET=shared-random-secret-32-plus-characters

# Enable only once the SePay adapter was tested with your linked bank account.
# ENABLE_VERIFIED_BANK_INBOX=1
# CLOUD_SYNC_SECRET and BANK_BRIDGE_SECRET must be configured independently.

# LAN requires a TLS certificate trusted by Android/iOS, and mandatory staff pairing.
# HUB_TLS_CERT_PATH=/absolute/path/to/lan-server-cert.pem
# HUB_TLS_KEY_PATH=/absolute/path/to/lan-server-key.pem
# PAIRING_ENFORCED=1
# Developer-only: ALLOW_INSECURE_LAN_DEV=1 (NEVER handle real transactions)
