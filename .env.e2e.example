# Bánh Mì Chợ POS — Isolated QA/E2E Environment Template
# NEVER connect to production, real bank account, real customer data, or live shop database.
NODE_ENV=development
STORE_DB_PATH=./store-data/e2e-disposable/bmc-e2e.sqlite
HUB_BIND_HOST=127.0.0.1
HUB_PORT=4400
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
SEED_DEMO_CATALOG=1

# Local QA Credentials — Must be distinct and >= 12 characters. NEVER commit real PINs.
BOOTSTRAP_OWNER_PIN=<GENERATE_UNIQUE_QA_PIN_12_PLUS>
BOOTSTRAP_CASHIER_PIN=<GENERATE_DIFFERENT_QA_PIN_12_PLUS>
BOOTSTRAP_STAFF_PIN=<GENERATE_DIFFERENT_QA_PIN_12_PLUS>
E2E_EXTRA_STAFF_PIN=<GENERATE_DIFFERENT_QA_PIN_12_PLUS>

# Seed Safety Guards
E2E_ALLOW_SEED=YES
E2E_ISOLATED_DB_MARKER=BMC_E2E_DISPOSABLE
E2E_HUB_URL=http://127.0.0.1:4400
E2E_SEED_ORDERS=340
E2E_SEED_REPORT=./artifacts/qa/e2e-seed-report.json

# Optional Cloud / Bank / Hardware — Leave unset in default automated local run
# BANK_BRIDGE_SECRET=
# ENABLE_VERIFIED_BANK_INBOX=
# CLOUD_SYNC_URL=
# PRINTER_HOST=

